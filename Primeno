
#!/bin/zsh
#echo "Prime Number Detection"
#echo "number -ve, 1, 0, not prime"
#echo "number 2 or 3 prime"
echo "Enter Number:"
read num 
if [ $num -lt 0 ];
then
 echo "Enter a positive number!"
elif [ $num -eq 0 -o $num -eq 1 ];
then 
 echo "The number $num is not a prime number"
elif [ $num -eq 2 -o $num -eq 3 ];
then 
 echo "The number $num is a prime number"
else 
  i=2
  flag=0
  while [ $i -lt $num ]
  do 
    rem=`expr $num % $i`
    if [ $rem -eq 0 ];
    then 
     flag=1
     break
    fi
    i=`expr $i + 1`
  done
  if [ $flag -eq 0 ];
  then
   echo "Number $num is a prime number"
  else
   echo "Number $num is not a prime number"
  fi
fi 
